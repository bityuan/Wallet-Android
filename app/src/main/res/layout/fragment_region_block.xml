<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/iv_region_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_region_block_error" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/region_block_title"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/region_block_subtitle"
        android:textColor="#99FFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/btn_retry"
        android:layout_width="240dp"
        android:layout_height="48dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="280dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/bg_region_block_btn_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/region_block_retry"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

</LinearLayout>
